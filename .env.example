# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Preferred backend port. If it's busy the server automatically uses the next free
# port and prints the real one — so a collision never stops it from starting.
PORT=5000
# CORS allow-list (comma-separated). In dev any localhost origin is allowed anyway,
# so this only matters in production — set it to your deployed frontend URL(s).
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio
# Optional: force DNS resolvers if mongodb+srv SRV lookups fail on your machine.
# LOCAL DEV ONLY — do not set this on Render. It would push every Atlas SRV lookup
# out to a public resolver instead of Render's internal one, slowing each cold start.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── First admin (created by `npm run seed`) ───────────────────────────────────
ADMIN_NAME=Mohd Zaid
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ── Cloudinary (image uploads; uploads are disabled if these are blank) ────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio-cms

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Browser-side API base URL. Vite BAKES this into the JS bundle at BUILD time — it
# is not read at runtime, so changing it requires a fresh build/redeploy on Vercel.
# Leave UNSET for local dev — the Vite dev server proxies /api to the backend.
# Set it ONLY in your production frontend host (Vercel). Must include the /api suffix
# and must NOT have a trailing slash:
# VITE_API_URL=https://portfolio-cms-api.onrender.com/api
